/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "x4-website",
	"compatibility_date": "2025-05-06",
	"main": "./src/index.js",
	"assets": {
		"directory": "./public",
		// Serve public/404.html on a miss. Without this, Workers returns its own
		// bare 404 and the custom page is dead weight. (The old .htaccess tried
		// to do this, but Workers does not read .htaccess.)
		"not_found_handling": "404-page",
		"html_handling": "auto-trailing-slash",
		"binding": "ASSETS",
		// Without this, a request that matches no asset is answered with 404.html
		// and never reaches the Worker — so POST /api/enquiry would 404. With it,
		// the Worker sees every request and hands all non-API paths straight back
		// to the asset server, which keeps the two settings above working.
		// (Newer Wrangler allows run_worker_first: ["/api/*"], which would be
		// tighter. The pinned 4.14.2 only accepts the boolean.)
		"run_worker_first": true
	},
	"observability": {
		"enabled": true
	},
	/**
	 * Enquiry form configuration — see docs/lead-forms.md.
	 *
	 * These are not secrets, so they live here in the repo. The two real secrets
	 * (ENTRA_CLIENT_SECRET and TURNSTILE_SECRET_KEY) are set with
	 * `wrangler secret put` and must never be written into this file.
	 *
	 * While DATAVERSE_URL, ENTRA_TENANT_ID, ENTRA_CLIENT_ID or the client secret
	 * are blank, POST /api/enquiry answers 503 instead of silently losing a lead.
	 */
	"vars": {
		// The XFour production environment. No trailing slash.
		"DATAVERSE_URL": "https://xfour.crm11.dynamics.com",
		"ENTRA_TENANT_ID": "86492a79-a8af-44ee-a575-462f841e0ad5",
		// App registration "XFour website enquiry forms".
		"ENTRA_CLIENT_ID": "f100b65e-b13e-4e54-9749-bdc34a629d83",
		// Site key of the "xfour.co.uk enquiry forms" Turnstile widget. Public by
		// design; the matching secret key is a Worker secret.
		"TURNSTILE_SITE_KEY": "0x4AAAAAAFT_mDl3N3uC7M63",
		// Integer values of the two new Lead Source option set entries.
		// "Web — Dynamics 365" and "Web — Managed IT".
		"LEAD_SOURCE_DYNAMICS": "828640001",
		"LEAD_SOURCE_MANAGED_IT": "828640002",
		// systemuser GUIDs. Two vars so the journeys can be split later; for now
		// Ben owns both, so the same GUID goes in both (decided 11 Oct 2026).
		"LEAD_OWNER_DYNAMICS": "bd166bb6-921f-ef11-840b-002248425de8",
		"LEAD_OWNER_MANAGED_IT": "bd166bb6-921f-ef11-840b-002248425de8"
	}
	/**
	 * Smart Placement
	 * Docs: https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": { "mode": "smart" },

	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [{ "binding": "MY_SERVICE", "service": "my-service" }]
}
