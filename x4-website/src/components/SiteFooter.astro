---
// The site footer, written once. The year comes from the build date, so it
// cannot go stale on a page nobody remembers to edit.
const year = new Date().getFullYear();
---

<footer class="page-footer dark">
	<div class="container">
		<div class="row d-xl-flex justify-content-xl-center">
			<div class="col-sm-3">
				<h5>About us</h5>
				<ul>
					<li><a href="/about-us">Company Information</a></li>
					<li><a href="/contact-us">Contact us</a></li>
				</ul>
			</div>
			<div class="col-sm-3">
				<h5>Legal</h5>
				<ul>
					<li><a href="/legal/legal">Legal Centre</a></li>
					<li><a href="/legal/privacy">Privacy Policy</a></li>
					<li><a href="/legal/cookies">Cookie Policy</a></li>
					<!-- Points at the cookie policy so it still works without JavaScript;
					     consent.js upgrades it into a button that opens the panel in place. -->
					<li><a href="/legal/cookies" data-x4-consent-open>Cookie choices</a></li>
				</ul>
			</div>
		</div>
	</div>
	<div class="footer-copyright">
		<p>© {year} XFour IT Limited · Registered in England and Wales, company no. 11776254 · Registered
			office: 100 Berkshire Place, C/O KT Wells Ltd, Winnersh Triangle, Wokingham, RG41 5RD</p>
		<p><a href="mailto:hello@xfour.co.uk">hello@xfour.co.uk</a> · <a href="tel:+442045912641">020 4591 2641</a></p>
	</div>
</footer>
