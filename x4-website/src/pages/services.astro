---
import BaseLayout from '../layouts/BaseLayout.astro';

// Internal notes for whoever edits this file next live here, in the
// frontmatter, because frontmatter never reaches the browser. An HTML comment
// ships in the page source, where any visitor can read it (XFO-96).
//
// The Managed IT card (XFO-67) is an anchor, the same treatment the App
// Development card was given, so it reaches the /it-support page. The new home
// page is the main door to it, but that was held in a draft pull request and
// this card was live. Its body copy is the plain terms the Journey B page
// actually promises.
//
// The App & Prototype Development card is the other anchor; the four cards
// between them are plain divs with no link. Its body copy is the approved hero
// sub-headline from /app-development (XFO-17), reused verbatim.
---

<BaseLayout
	title="Services: Managed IT & Dynamics 365 | XFour"
	description="Managed IT support, Microsoft Dynamics 365 consultancy, project management and web design for small businesses in Reading and the Thames Valley."
	navCurrent="/services"
>
<section class="clean-block features">
    <div class="container">
        <div class="block-heading">
            <h1 class="text-info">Services</h1>
            <p>Seamless Solutions, Smarter Business - Your Partner in Dynamics 365 & Managed IT Services.</p>
        </div>
        <div class="row justify-content-center">
            <a class="col-md-5 feature-box text-decoration-none text-reset" href="/it-support" data-bss-hover-animate="pulse"><i class="fas fa-laptop icon"></i>
                <h4>Managed IT</h4>
                <p>Response times in writing, cover hours that fit your day, and one price per user per month. For Thames Valley businesses with no IT person.</p>
            </a>
            <div class="col-md-5 feature-box" data-bss-hover-animate="pulse"><i class="far fa-question-circle icon"></i>
                <h4>Consultancy</h4>
                <p>Not sure how to proceed? Talk to one of our experts to help you make the right decision.&nbsp;</p>
            </div>
            <div class="col-md-5 feature-box" data-bss-hover-animate="pulse"><i class="fas fa-globe icon"></i>
                <h4>Web Design</h4>
                <p>Our SEO &amp; web design experts can ensure your business is represented in the best way possible.&nbsp;</p>
            </div>
            <div class="col-md-5 feature-box" data-bss-hover-animate="pulse"><i class="icon-refresh icon"></i>
                <h4>Project Management</h4>
                <p>Ensure your project is a success and rely on our proven team of business change managers and subject matter experts to provide the best service.&nbsp;</p>
            </div>
            <a class="col-md-5 feature-box text-decoration-none text-reset" href="/app-development" data-bss-hover-animate="pulse"><i class="fab fa-apple icon"></i>
                <h4>App &amp; Prototype Development</h4>
                <p>XFour Labs builds native iOS apps and working prototypes for people who need something real in weeks, not a slide deck in months.</p>
            </a>
        </div>
    </div>
</section>
</BaseLayout>
