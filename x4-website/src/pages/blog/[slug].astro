---
import { getCollection, getEntry, render } from 'astro:content';
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';

export async function getStaticPaths() {
	// Drafts get no page at all: nothing links to one, so there is nothing to
	// 404, and a draft can never leak by someone finding its URL.
	const posts = await getCollection('blog', ({ data }) => !data.draft);
	return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
// `post.data.author` is a reference, not the author's details -- those live
// on the authors collection entry it points to.
const author = await getEntry(post.data.author);
---

<BlogPostLayout
	title={post.data.title}
	description={post.data.description}
	author={author.data}
	publishDate={post.data.publishDate}
	updatedDate={post.data.updatedDate}
>
	<Content />
</BlogPostLayout>
