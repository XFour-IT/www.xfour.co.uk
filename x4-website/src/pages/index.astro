---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="IT Support & Dynamics 365 Consultancy in Reading | XFour"
	description="XFour provides Microsoft Dynamics 365 consultancy and managed IT support for small businesses in Reading and across the Thames Valley. Call 0118 370 2920."
	navCurrent="/"
	mainClass="page landing-page"
>
<section class="clean-block clean-hero xfour-hero">
    <div class="text">
        <h1 class="h2">Dynamics 365 and managed IT for small businesses</h1>
        <p>XFour supports small businesses in Reading and across the Thames Valley to make meaningful digital transformation, because every entrepreneur deserves a successful business.</p><a class="btn btn-primary btn-lg" role="button" href="/contact-us">Talk to us</a> <a class="btn btn-outline-light btn-lg" role="button" href="/services">See our services</a>
    </div>
</section>
<!-- XFO-17: one line of proof directly under the hero. Additive — the hero copy above
     is untouched. -->
<section class="clean-block py-3">
    <div class="container">
        <p class="text-center mb-0">We build native iOS apps. <a href="/app-development">See Slay, our app on the App Store →</a></p>
    </div>
</section>
<section class="clean-block clean-info dark">
    <div class="container">
        <div class="block-heading">
            <h2 class="text-info">Who are we?</h2>
            <p>XFour is a team of experts, working to provide you with the best IT imaginable.&nbsp;</p>
        </div>
        <section class="highlight-blue">
            <div class="container">
                <div class="intro">
                    <h2 class="text-center"></h2>
                    <h5 class="text-center">Seamless Solutions, Smarter Business - Your Partner in Dynamics 365 & Managed IT Services.</h5>
                </div>

            </div>
        </section>
    </div>
</section>
</BaseLayout>
