---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Contact Us | XFour IT Support, Reading"
	description="Contact XFour. Call 0118 370 2920, email support@xfour.co.uk, or use the live chat on this page. IT support and Dynamics 365 help for Thames Valley businesses."
	navCurrent="/contact-us"
	mainClass="page contact-us-page"
>
<section class="clean-block clean-form dark">
    <div class="container">
        <div class="block-heading">
            <h1 class="text-info">Contact Us</h1>
            <p>Get in touch with us today and learn more</p>
        </div>
    </div>
    <div class="container">
        <div class="row">
            <div class="col-md-4" data-bss-hover-animate="pulse" style="text-align: center;"><i class="fas fa-phone" style="font-size: 100px;padding: 1%;"></i>
                <h2 class="h4" style="font-weight: bold;">Give us a ring</h2>
                <p><a href="tel:+441183702920">0118 370 2920</a></p>
            </div>
            <div class="col-md-4" data-bss-hover-animate="pulse" style="text-align: center;"><i class="fas fa-envelope" style="font-size: 100px;padding: 1%;"></i>
                <h2 class="h4" style="font-weight: bold;">Email Us</h2>
                <p><a href="mailto:support@xfour.co.uk">support@xfour.co.uk</a></p>
            </div>
            <div class="col-md-4" data-bss-hover-animate="pulse" style="text-align: center;"><i class="fas fa-map-marked-alt" style="font-size: 100px;padding: 1%;"></i>
                <h2 class="h4" style="font-weight: bold;">Send us a letter</h2>
                <p>4b Paddock Road<br>Reading<br>RG4 5BY</p>
                <h5 style="font-style: italic;">Mail Only Please</h5>
            </div>
        </div>
    </div>
</section>
<section class="highlight-blue">
    <div class="container">
        <div class="intro">
            <h2 class="text-center">Our Partnership</h2>
            <p class="text-center">Seamless Solutions, Smarter Business - Your Partner in Dynamics 365 & Managed IT Services.<br></p>
        </div>
        
    </div>
</section>
</BaseLayout>
